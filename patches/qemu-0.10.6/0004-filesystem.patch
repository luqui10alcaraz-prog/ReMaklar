+static const char *translate_path(const char *input, char *buffer, size_t capacity)
+{
+    char joined[8192], normalized[4096];
+    const char *start, *end;
+    size_t length = strlen(interp_prefix), used = 1, n;
+    char *slash;
+    if (length && !strncmp(input, interp_prefix, length) &&
+        (!input[length] || input[length] == '/')) input += length;
+    if (!*input) { errno = ENOENT; return NULL; }
+    if (snprintf(joined, sizeof(joined), "%s/%s", input[0] == '/' ? "" : guest_cwd, input) >= sizeof(joined)) {
+        errno = ENAMETOOLONG; return NULL;
+    }
+    normalized[0] = '/'; normalized[1] = 0;
+    for (start = joined; *start; start = end) {
+        while (*start == '/') start++;
+        end = start; while (*end && *end != '/') end++;
+        n = end - start;
+        if (!n || (n == 1 && *start == '.')) continue;
+        if (n == 2 && start[0] == '.' && start[1] == '.') {
+            slash = strrchr(normalized, '/');
