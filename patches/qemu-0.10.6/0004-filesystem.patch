+int remaklar_set_cwd(const char *input)
+{
+    char path[8192]; struct stat st;
+    if (!translate_path(input, path, sizeof(path)) || stat(path, &st)) return -1;
+    if (!S_ISDIR(st.st_mode)) { errno = ENOTDIR; return -1; }
+    strcpy(guest_cwd, path + strlen(interp_prefix));
+    return 0;
+}
