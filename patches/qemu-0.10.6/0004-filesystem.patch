+        }
+        if (used + n + 2 > sizeof(normalized)) { errno = ENAMETOOLONG; return NULL; }
+        if (used > 1) normalized[used++] = '/';
+        memcpy(normalized + used, start, n); used += n; normalized[used] = 0;
+    }
+    if (snprintf(buffer, capacity, "%s%s", interp_prefix, normalized) >= capacity) {
+        errno = ENAMETOOLONG; return NULL;
+    }
+    return buffer;
+}
