+static int legacy_smc_write(struct sigcontext *s)
+{
+    const unsigned char *p;
+    uint32_t address = 0;
+    unsigned int opcode, modrm, mod, rm, sib, base;
+    int flags;
+    /* Only decode the MOV stores emitted by this i386 TCG backend, inside a
+     * known translated block. This recovers an address absent from Darwin 6's
+     * legacy signal frame; it is not a general x86 instruction interpreter. */
+    if (!s || !tb_find_pc(s->sc_eip)) return 0;
+    p = (const unsigned char *)s->sc_eip;
+    if (*p == 0x66) p++;
+    opcode = *p++;
+    if (opcode != 0x88 && opcode != 0x89) return 0;
+    modrm = *p++; mod = modrm >> 6; rm = modrm & 7;
+    if (mod == 3) return 0;
+    if (rm == 4) {
