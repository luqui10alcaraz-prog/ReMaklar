+
+/* Bulk reads of an original freshly initialized NX_NULLEVENT are valid in
+ * every union layout only while all its actual data bytes remain zero. */
+int rm_hid_null_field(volatile unsigned char *base,unsigned bytes,unsigned pos,
+                     struct rm_field *f)
+{
+    unsigned entry,within,j;
+    if(pos<232 || pos>=bytes)return 0;
+    entry=232+((pos-232)/84)*84;within=(pos-232)%84;
+    if(entry>=232+240*84 || within<36 || bytes-entry<84)return 0;
+    if(*(volatile rm_u32 *)(base+entry+8)!=0)return 0;
+    for(j=36;j<84;j++)if(base[entry+j])return 0;
+    f->offset=entry+36+((within-36)/4)*4;f->size=4;f->kind=RM_BYTES;return 1;
 }
 
