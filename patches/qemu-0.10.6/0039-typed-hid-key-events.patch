+    data=within-36;f->kind=RM_NUMBER;
+    if(data<12){f->offset=entry+36+(data/2)*2;f->size=2;}
+    else {f->offset=entry+48+((data-12)/4)*4;f->size=4;}
+    return 1;
+}
 
