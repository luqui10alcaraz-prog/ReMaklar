+/* IOHIDFamily-33 v3: EvOffsets(8), EvGlobals.lleq(224), NXEQElement(84).
+ * Select NXEventData.key by the actual native event discriminator, never by
+ * the width of a PPC load. The original consumer owns the slot's semaphore. */
+int rm_hid_key_field(volatile unsigned char *base,unsigned bytes,unsigned pos,
+                     struct rm_field *f)
+{
+    unsigned entry,within,data,type;
+    if(pos<232 || pos>=bytes)return 0;
+    entry=232+((pos-232)/84)*84;within=(pos-232)%84;
+    if(entry>=232+240*84 || within<36 || bytes-entry<84)return 0;
+    type=*(volatile rm_u32 *)(base+entry+8);
