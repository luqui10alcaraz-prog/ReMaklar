--- /dev/null
+++ b/darwin-user/remaklar/bootstrap.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef REMAKLAR_BOOTSTRAP_H
+#define REMAKLAR_BOOTSTRAP_H
+extern const char *interp_prefix;
+int remaklar_guest_access(uint32_t address, uint32_t length, int prot);
+uint32_t remaklar_mach(CPUState *env);
