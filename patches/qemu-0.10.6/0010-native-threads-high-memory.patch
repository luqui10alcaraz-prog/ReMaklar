+ if(!t || t->cpu!=cpu || t->guest!=destination)qerror("thread termination context mismatch");
+ t->live=0;cpu->reserve=(target_ulong)-1;
+ fprintf(stderr,"real PPC thread terminating guest=%x\n",t->guest);
+ remaklar_gate_leave();pthread_exit(NULL);
