+/* Native scheduling with one serialized TCG execution context at a time.
+ * Mach waits release the execution gate; every 64 TBs yields even in PPC spin.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#ifdef __APPLE__
+#include <pthread.h>
+#include <sched.h>
+struct rm_thread_context {
+ CPUState *cpu;pthread_t thread;mach_port_t host;uint32_t guest;
+ pthread_mutex_t ready_lock;pthread_cond_t ready;int started,live;
+};
+static pthread_mutex_t rm_gate=PTHREAD_MUTEX_INITIALIZER;
+static pthread_key_t rm_thread_key;
+static pthread_once_t rm_thread_once=PTHREAD_ONCE_INIT;
+static struct rm_thread_context rm_threads[64];
+static void rm_thread_key_init(void){if(pthread_key_create(&rm_thread_key,NULL))qerror("thread key allocation");}
+void remaklar_gate_enter(CPUState *cpu)
+{
+ struct rm_thread_context *t;
+ pthread_once(&rm_thread_once,rm_thread_key_init);
+ pthread_mutex_lock(&rm_gate);
+ t=pthread_getspecific(rm_thread_key);
+ if(!t) {
+  t=&rm_threads[0];t->cpu=cpu;t->thread=pthread_self();t->live=1;
+  pthread_setspecific(rm_thread_key,t);
+ }
+ global_env=cpu;
+}
+void remaklar_gate_leave(void){
+ struct rm_thread_context *t=pthread_getspecific(rm_thread_key);
+ if(t && t->cpu)t->cpu->reserve=(target_ulong)-1;
+ pthread_mutex_unlock(&rm_gate);
+}
+void remaklar_gate_yield(void){remaklar_gate_leave();sched_yield();}
+static int rm_is_thread(uint32_t guest)
+{
+ unsigned i;
+ for(i=0;i<64;i++)if(rm_threads[i].live && rm_threads[i].guest==guest && guest)return 1;
+ return 0;
+}
+static uint32_t rm_thread_right(void)
+{
+ struct rm_thread_context *t=pthread_getspecific(rm_thread_key);
+ mach_port_t host=mach_thread_self();uint32_t guest=native_export(host);
+ t->host=host;t->guest=guest;return guest;
+}
+static void *rm_thread_start(void *arg)
+{
+ struct rm_thread_context *t=arg;
+ pthread_setspecific(rm_thread_key,t);
+ pthread_mutex_lock(&t->ready_lock);
+ t->host=mach_thread_self();t->started=1;
+ pthread_cond_signal(&t->ready);pthread_mutex_unlock(&t->ready_lock);
+ cpu_loop(t->cpu);return NULL;
+}
+static uint32_t rm_thread_create(CPUState *parent,uint32_t state,uint32_t *guest)
+{
+ unsigned i,j;int error;CPUState *cpu;struct rm_thread_context *t;
+ for(i=1;i<64 && rm_threads[i].cpu;i++);
+ if(i==64)return KERN_RESOURCE_SHORTAGE;
+ if(!remaklar_guest_access(ldl(g2h(state)),4,PAGE_EXEC) ||
+    !remaklar_guest_access(ldl(g2h(state+12))-16,16,PAGE_WRITE))return KERN_INVALID_ADDRESS;
+ cpu=cpu_copy(parent);if(!cpu)return KERN_RESOURCE_SHORTAGE;
+ cpu->nip=ldl(g2h(state));
+ for(j=0;j<32;j++)cpu->gpr[j]=ldl(g2h(state+8+j*4));
+ for(j=0;j<8;j++)cpu->crf[j]=(ldl(g2h(state+136))>>(28-j*4))&15;
+ cpu->xer=ldl(g2h(state+140));cpu->lr=ldl(g2h(state+144));cpu->ctr=ldl(g2h(state+148));
+ cpu->reserve=(target_ulong)-1;cpu->rm_reserved_value=0;cpu->rm_self_pointer=0;cpu->rm_quantum=0;
+ cpu->exception_index=-1;cpu->interrupt_request=0;cpu->exit_request=0;
+ t=rm_threads+i;memset(t,0,sizeof(*t));t->cpu=cpu;
+ pthread_mutex_init(&t->ready_lock,NULL);pthread_cond_init(&t->ready,NULL);
+ pthread_mutex_lock(&t->ready_lock);
