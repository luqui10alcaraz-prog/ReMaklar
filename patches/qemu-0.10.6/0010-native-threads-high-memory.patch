+void remaklar_gate_enter(CPUState *cpu){global_env=cpu;}
+void remaklar_gate_leave(void){}
+void remaklar_gate_yield(void){}
+static int rm_is_thread(uint32_t guest){return 0;}
+static uint32_t rm_thread_right(void){send_refs[THREAD_SELF]++;return THREAD_SELF;}
+static uint32_t rm_thread_create(CPUState *p,uint32_t s,uint32_t *g){return 4;}
+static void rm_thread_exit(CPUState *cpu,uint32_t destination){qerror("native threads require Darwin");}
+static void rm_threads_fork_child(CPUState *cpu){}
+#endif
