+    if(!v->writable)return EACCES;
+    if(!f || pos!=f->offset || f->size!=4)return EINVAL;
+    *ok=cas((volatile rm_u32 *)(v->base+pos),physical(f,old),physical(f,value))==(rm_u32)physical(f,old);
+    return 0;
+}
