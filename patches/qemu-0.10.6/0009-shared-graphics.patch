+/* Live typed access to original i386 IOKit objects. No mirrored allocation.
+ * Layouts: IOGraphics-40, IOHIDFamily-33, XNU-344. */
+#include "typed-live.c"
+uint32_t remaklar_live_min=0xffffffffU,remaklar_live_max;
+static unsigned live_kind[64]; /* 1: framebuffer header, 2: HID header. */
+
+static void live_bounds(void)
+{
+    unsigned i;
+    uint32_t prior=remaklar_live_max;
+    remaklar_live_min=0xffffffffU;remaklar_live_max=0;
+    for(i=0;i<64;i++)if(live_kind[i]) {
+        uint32_t a=native_iomappings[i].address,b=a+native_iomappings[i].bytes;
+        if(a<remaklar_live_min)remaklar_live_min=a;
+        if(b>remaklar_live_max)remaklar_live_max=b;
+    }
+    if(!!prior!=!!remaklar_live_max && global_env)tb_flush(global_env);
+}
+
+/* Select a single declared field, never infer a union's active representation
+ * from the width of a PPC instruction. Image/event unions remain fail-closed. */
+static int live_field(unsigned kind,unsigned pos,struct rm_field *f)
+{
+    unsigned n=0,start=0;
+    f->kind=RM_NUMBER;
+    if(kind==1) {
+        if(pos<8)n=4;
+        else if(pos<12){n=1;start=8;}
+        else if(pos<56){n=2;start=12;}
+        else if(pos<64){n=4;start=56;}
+        else if(pos<80){n=8;start=64;}
+        else if(pos<200){n=4;start=80;}
+        else if(pos<204){n=1;start=200;}
+        else if(pos<236){n=2;start=204;}
+        else {n=4;start=236;} /* Native 32-bit cursor pixels, checked at map time. */
+    } else {
+        if(pos<8)n=4;
+        else {
+            start=8;pos-=8;
+            if(pos<32)n=4;
+            else if(pos<36){n=2;start+=32;pos-=32;}
+            else if(pos<40){n=4;start+=36;pos-=36;}
+            else if(pos<56){n=2;start+=40;pos-=40;}
+            else if(pos<192){n=4;start+=56;pos-=56;}
+            else if(pos<196){n=4;start+=192;pos-=192;f->kind=RM_HID_BITS;}
+            else if(pos<216){n=4;start+=196;pos-=196;}
+            else if(pos<220){n=1;start+=216;pos-=216;}
+            else if(pos<224){n=4;start+=220;pos-=220;}
+            else {
+                /* Each 84-byte NXEQElement starts with next and sema.
+                 * Until event-union semantics are validated, only these two
+                 * words can be touched; no fabricated event data. */
+                unsigned entry=(pos-224)/84,within=(pos-224)%84;
+                if(entry>=240 || within>=8)return 0;
+                n=4;start=8+224+entry*84;pos=within;
+            }
+        }
+        f->offset=start+(pos/n)*n;f->size=n;return n!=0;
+    }
+    if(!n)return 0;
+    f->offset=start+((pos-start)/n)*n;f->size=n;return 1;
+}
+
+static int live_view(uintptr_t address,unsigned n,int write,struct rm_view *v,struct rm_field *f,unsigned *offset)
+{
+    unsigned i;
+    if(address>0xffffffffU)return 0;
+    for(i=0;i<64;i++)if(live_kind[i] && address>=native_iomappings[i].address &&
+        address-native_iomappings[i].address<native_iomappings[i].bytes) {
+        unsigned pos=address-native_iomappings[i].address;
+        if(!remaklar_guest_access(address,n,write?PAGE_WRITE:PAGE_READ))qerror("live shared memory protection violation address=%lx",(unsigned long)address);
+        if(!live_field(live_kind[i],pos,f))qerror("unverified live shared field kind=%u offset=%u width=%u",live_kind[i],pos,n);
+        v->base=(volatile unsigned char *)(uintptr_t)native_iomappings[i].address;
+        v->bytes=native_iomappings[i].bytes;v->fields=f;v->count=1;
+        v->writable=remaklar_guest_access(address,n,PAGE_WRITE);*offset=pos;return 1;
+    }
+    return 0;
+}
+
+uint64_t remaklar_live_load(uintptr_t address,unsigned n)
+{
+    struct rm_view v;struct rm_field f;unsigned off;rm_u64 x;
+    if(live_view(address,n,0,&v,&f,&off)) {
+        int error;
+        /* lfd/stfd may span two pixels. Each pixel is a native uint32,
+         * not half of a native uint64. PPC does not require an atomic pair. */
+        if(n==8 && f.size==4 && off>=236 && f.kind==RM_NUMBER && v.base && live_kind_at((uint32_t)(uintptr_t)v.base)==1 && !(off&3) && v.bytes-off>=8) {
+            uint64_t hi=remaklar_live_load(address,4);
+            return (hi<<32)|remaklar_live_load(address+4,4);
+        }
+        error=rm_read(&v,off,n,&x);
+        if(error)qerror("live shared read unsupported offset=%u width=%u errno=%d",off,n,error);
+        return x;
+    }
+    switch(n) {
+    case 1:return ldub_p((void *)address);
+    case 2:return lduw_be_p((void *)address);
+    case 4:return (uint32_t)ldl_be_p((void *)address);
+    case 8:return ldq_be_p((void *)address);
+    }
+    qerror("invalid live load width");return 0;
+}
+
+void remaklar_live_store(uintptr_t address,unsigned n,uint64_t x)
+{
+    struct rm_view v;struct rm_field f;unsigned off;
+    if(live_view(address,n,1,&v,&f,&off)) {
+        int error;
+        if(n==8 && f.size==4 && off>=236 && f.kind==RM_NUMBER && v.base && live_kind_at((uint32_t)(uintptr_t)v.base)==1 && !(off&3) && v.bytes-off>=8) {
+            remaklar_live_store(address,4,x>>32);
+            remaklar_live_store(address+4,4,x);
+            return;
+        }
+        error=rm_write(&v,off,n,x);
+        if(error)qerror("live shared write unsupported offset=%u width=%u errno=%d",off,n,error);
+        return;
+    }
+    switch(n) {
+    case 1:stb_p((void *)address,x);return;
+    case 2:stw_be_p((void *)address,x);return;
+    case 4:stl_be_p((void *)address,x);return;
+    case 8:stq_be_p((void *)address,x);return;
+    }
+    qerror("invalid live store width");
+}
+
+int remaklar_live_cas(uint32_t address,uint32_t old,uint32_t value)
+{
+    struct rm_view v;struct rm_field f;unsigned off;int ok;
+    if(live_view(address,4,1,&v,&f,&off)) {
+        int error=rm_cas32(&v,off,old,value,&ok);
+        if(error)qerror("live shared atomic unsupported offset=%u errno=%d",off,error);
+        return ok;
+    }
+    return cas((volatile rm_u32 *)(uintptr_t)address,bswap32(old),bswap32(value))==bswap32(old);
+}
+
+static unsigned live_kind_at(uint32_t address)
+{
+    unsigned i;
+    for(i=0;i<64;i++)if(live_kind[i] && address>=native_iomappings[i].address && address-native_iomappings[i].address<native_iomappings[i].bytes) {
+        if(address!=native_iomappings[i].address)qerror("typed memory entry requires base-aligned view");
+        return live_kind[i];
+    }
+    return 0;
+}
+static void live_alias(uint32_t address,uint32_t bytes,uint32_t object,uint64_t offset,uint32_t copy)
+{
+    unsigned i;
+    if(object>=4096 || !live_object_kind[object])return;
+    if(offset || copy)qerror("typed memory alias offset/COW needs a verified descriptor view");
+    for(i=0;i<64 && native_iomappings[i].connection;i++);
+    if(i==64)qerror("typed alias table exhausted");
+    native_iomappings[i].connection=object;native_iomappings[i].type=0xffffffffU;
+    native_iomappings[i].address=address;native_iomappings[i].bytes=bytes;
+    live_kind[i]=live_object_kind[object];live_bounds();
+    fprintf(stderr,"typed Mach memory-entry view kind=%u address=%x bytes=%u object=%x\n",live_kind[i],address,bytes,object);
+}
+static void live_forget(uint32_t address,uint32_t bytes)
+{
+    unsigned i;
+    for(i=0;i<64;i++)if(live_kind[i] && address<=native_iomappings[i].address &&
+       (uint64_t)address+bytes>=(uint64_t)native_iomappings[i].address+native_iomappings[i].bytes) {
+        live_kind[i]=0;memset(&native_iomappings[i],0,sizeof(native_iomappings[i]));
+    }
+    live_bounds();
+}
