+
+/* IOHIDSystem::updateButtons sends NX_SYSDEFINED/subtype7 using misc.L.
+ * Other compound subtypes may select S/C/F and remain fail-closed. */
+int rm_hid_auxmouse_field(volatile unsigned char *base,unsigned bytes,unsigned pos,
+                          struct rm_field *f)
+{
+    unsigned entry,within,data;
+    if(pos<232 || pos>=bytes)return 0;
+    entry=232+((pos-232)/84)*84;within=(pos-232)%84;
+    if(entry>=232+240*84 || within<36 || bytes-entry<84)return 0;
+    if(*(volatile rm_u32 *)(base+entry+8)!=14 ||
+       *(volatile unsigned short *)(base+entry+38)!=7)return 0;
+    data=within-36;f->offset=entry+36+(data/4)*4;f->size=4;
+    f->kind=data<4?RM_PAIR16:RM_NUMBER;return 1;
 }
 
