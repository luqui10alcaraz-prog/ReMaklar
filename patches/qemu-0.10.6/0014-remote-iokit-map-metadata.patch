+/* Cross-process translator metadata only. Bytes stay in original kernel maps.
+ * Each process owns a private, mode-0600 mailbox with a shared event page.
+ * Writers hold the file lock; the aligned count publishes complete events.
+ * This channel never supplies application replies or framebuffer contents.
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#ifdef __APPLE__
+#define RM_REMOTE_MAGIC 0x524d0043U
+#define RM_REMOTE_EVENTS 256
+struct rm_remote_event {uint32_t address,bytes,prot,kind,start,extent,remove;};
+struct rm_remote_mailbox {uint32_t magic,pid;volatile uint32_t count;struct rm_remote_event events[RM_REMOTE_EVENTS];};
+static struct rm_remote_mailbox *rm_remote_box;
+static int rm_remote_fd=-1,rm_remote_pid;
+static unsigned rm_remote_seen;
+static void rm_remote_lock(int fd,int lock)
+{
+ struct flock f;int r;
+ memset(&f,0,sizeof(f));f.l_type=lock?F_WRLCK:F_UNLCK;f.l_whence=SEEK_SET;
+ do {r=fcntl(fd,F_SETLKW,&f);}while(r<0 && errno==EINTR);
+ if(r<0)qerror("remote mapping metadata lock errno=%d",errno);
+}
+static void rm_remote_sync(void)
+{
+ char path[128];int pid=getpid();unsigned end,i;
+ if(pid!=rm_remote_pid) {
+  if(rm_remote_box)munmap(rm_remote_box,sizeof(*rm_remote_box));
+  if(rm_remote_fd>=0)close(rm_remote_fd);
+  sprintf(path,"/var/tmp/remaklar-remote-map-%d",pid);
+  /* PID reuse starts a fresh inode; a retained task right cannot designate
+   * a new task merely because its PID has been reused. */
+  unlink(path);rm_remote_fd=open(path,O_RDWR|O_CREAT|O_EXCL,0600);
+  if(rm_remote_fd<0 || ftruncate(rm_remote_fd,sizeof(*rm_remote_box)))qerror("remote mapping mailbox creation errno=%d",errno);
+  rm_remote_box=mmap(NULL,sizeof(*rm_remote_box),PROT_READ|PROT_WRITE,MAP_SHARED,rm_remote_fd,0);
+  if(rm_remote_box==MAP_FAILED)qerror("remote mapping mailbox mmap");
+  memset(rm_remote_box,0,sizeof(*rm_remote_box));rm_remote_box->pid=pid;rm_remote_box->magic=RM_REMOTE_MAGIC;
+  rm_remote_pid=pid;rm_remote_seen=0;
+ }
+ if(rm_remote_box->count==rm_remote_seen)return;
+ rm_remote_lock(rm_remote_fd,1);end=rm_remote_box->count;
+ if(end>RM_REMOTE_EVENTS || end<rm_remote_seen)qerror("remote mapping metadata sequence");
+ for(i=rm_remote_seen;i<end;i++) {
+  struct rm_remote_event e=rm_remote_box->events[i];unsigned slot;
+  if(!e.bytes || (uint64_t)e.address+e.bytes>0xc0000000ULL || e.kind>3 || (uint64_t)e.start+e.extent>e.bytes)qerror("remote mapping metadata bounds");
+  live_forget(e.address,e.bytes);
+  page_set_flags(e.address&~4095U,TARGET_PAGE_ALIGN(e.address+e.bytes),e.remove?0:((e.prot&7)|PAGE_VALID));
+  if(!e.remove && e.kind) {
+   for(slot=0;slot<64 && native_iomappings[slot].connection;slot++);
+   if(slot==64)qerror("remote typed mapping table exhausted");
+   native_iomappings[slot].connection=0xffffffffU;native_iomappings[slot].type=0xfffffffeU;
+   native_iomappings[slot].address=e.address;native_iomappings[slot].bytes=e.bytes;
+   live_kind[slot]=e.kind;live_start[slot]=e.start;live_extent[slot]=e.extent;
+  }
+  fprintf(stderr,"real remote mapping metadata applied address=%x bytes=%u kind=%u remove=%u\n",e.address,e.bytes,e.kind,e.remove);
+ }
+ rm_remote_seen=end;live_bounds();rm_remote_lock(rm_remote_fd,0);
+}
+static void rm_remote_publish(mach_port_t task,const struct rm_remote_event *event)
+{
+ char path[128];int pid=-1,fd;struct stat st;struct rm_remote_mailbox *box;unsigned n;
+ if(pid_for_task(task,&pid) || pid<1)qerror("remote mapping task lost");
+ sprintf(path,"/var/tmp/remaklar-remote-map-%d",pid);fd=open(path,O_RDWR);
+ if(fd<0){if(errno==ENOENT)return;qerror("remote mapping mailbox open errno=%d",errno);}
+ if(fstat(fd,&st) || st.st_size!=sizeof(*box) || st.st_uid!=geteuid() || !S_ISREG(st.st_mode) || (st.st_mode&077))qerror("invalid remote mapping mailbox file");
+ box=mmap(NULL,sizeof(*box),PROT_READ|PROT_WRITE,MAP_SHARED,fd,0);
+ if(box==MAP_FAILED)qerror("remote mapping writer mmap");
+ rm_remote_lock(fd,1);n=box->count;
+ if(box->magic!=RM_REMOTE_MAGIC || box->pid!=pid || n>=RM_REMOTE_EVENTS)qerror("remote mapping mailbox identity/capacity");
+ box->events[n]=*event;__asm__ __volatile__("" ::: "memory");box->count=n+1;
+ rm_remote_lock(fd,0);munmap(box,sizeof(*box));close(fd);
+ fprintf(stderr,"real remote mapping metadata published pid=%d address=%x kind=%u remove=%u\n",pid,event->address,event->kind,event->remove);
+}
