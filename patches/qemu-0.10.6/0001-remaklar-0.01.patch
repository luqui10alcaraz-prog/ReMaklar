diff --git a/darwin-user/remaklar/bootstrap-main.c b/darwin-user/remaklar/bootstrap-main.c
new file mode 100644
index 0000000..c47db90
--- /dev/null
+++ b/darwin-user/remaklar/bootstrap-main.c
@@ -0,0 +1,169 @@
+/* ReMaklar 0.01 Linux/i386 bring-up of QEMU's PPC Darwin user target.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Deliberately limited: no Mach IPC, dynamic linkage, commpage or guest signals.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <errno.h>
+#include <unistd.h>
+#include <signal.h>
+#include "qemu.h"
+
+const char *interp_prefix = "";
+unsigned long stack_size = 512 * 1024;
+CPUState *global_env;
+TaskState *first_task_state;
+unsigned long remaklar_probe_slide;
+static uint32_t exit_bridge;
+
+void qerror(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt); vfprintf(stderr, fmt, ap); va_end(ap);
+    fputc('\n', stderr); exit(125);
+}
+void gemu_log(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt); vfprintf(stderr, fmt, ap); va_end(ap);
+}
+
+/* User-only CPU model hooks: no board or devices are instantiated. */
+uint32_t cpu_ppc_load_tbl(CPUState *env) { qerror("unsupported timebase read"); return 0; }
+uint32_t cpu_ppc_load_tbu(CPUState *env) { qerror("unsupported timebase read"); return 0; }
+uint32_t cpu_ppc_load_atbl(CPUState *env) { qerror("unsupported timebase read"); return 0; }
+uint32_t cpu_ppc_load_atbu(CPUState *env) { qerror("unsupported timebase read"); return 0; }
+uint32_t cpu_ppc601_load_rtcu(CPUState *env) { qerror("unsupported timebase read"); return 0; }
+uint32_t cpu_ppc601_load_rtcl(CPUState *env) { qerror("unsupported timebase read"); return 0; }
+int ppc_dcr_read(ppc_dcr_t *d, int n, target_ulong *v) { return -1; }
+int ppc_dcr_write(ppc_dcr_t *d, int n, target_ulong v) { return -1; }
+/* Debug register descriptions are unused: the bootstrap has no GDB server. */
+void gdb_register_coprocessor(CPUState *env, gdb_reg_cb get, gdb_reg_cb set,
+                              int count, const char *xml, int position) { }
+
+static void host_signal(int sig, siginfo_t *info, void *context)
+{
+    if (cpu_signal_handler(sig, info, context))
+        return;
+    /* No synthesized guest signal support in 0.01. Async-safe diagnostic. */
+    {
+        static const char message[] = "remaklar: unhandled host memory fault\n";
+        int ignored = write(2, message, sizeof(message) - 1);
+        (void)ignored;
+    }
+    _exit(126);
+}
+
+static int guest_readable(uint32_t addr, uint32_t len)
+{
+    uint64_t end = (uint64_t)addr + len;
+    uint64_t page;
+    if (end > 0x100000000ULL) return 0;
+    for (page = addr & TARGET_PAGE_MASK; page < end; page += TARGET_PAGE_SIZE)
+        if ((page_get_flags(page) & (PAGE_VALID | PAGE_READ)) !=
+            (PAGE_VALID | PAGE_READ)) return 0;
+    return 1;
+}
+
+static void darwin_syscall(CPUState *env)
+{
+    uint32_t number = env->gpr[0];
+    int result, guest_errno = 0;
+    fprintf(stderr, "syscall pc=%08x r0=%u r3=%08x r4=%08x r5=%08x\n",
+            (unsigned)env->nip, number, (unsigned)env->gpr[3],
+            (unsigned)env->gpr[4], (unsigned)env->gpr[5]);
+    switch (number) {
+    case 1: /* Darwin SYS_exit */
+        exit(env->gpr[3] & 255);
+    case 4: /* Darwin SYS_write: buffers contain bytes, no word swapping. */
+        if (!guest_readable(env->gpr[4], env->gpr[5])) {
+            result = -1; guest_errno = 14; /* Darwin EFAULT */
+        } else {
+            result = write(env->gpr[3], g2h(env->gpr[4]), env->gpr[5]);
+            if (result < 0) {
+                switch (errno) {
+                case EBADF: guest_errno = 9; break;
+                case EINTR: guest_errno = 4; break;
+                case EPIPE: guest_errno = 32; break;
+                default: qerror("unsupported host write errno %d", errno);
+                }
+            }
+        }
+        break;
+    default:
+        qerror("unsupported Darwin syscall/trap %d at %08x",
+               (int32_t)number, (unsigned)env->nip);
+    }
+    /* QEMU resumes just after sc. Jaguar skips the cerror branch on success. */
+    env->gpr[3] = guest_errno ? guest_errno : result;
+    if (!guest_errno) env->nip += 4;
+    fprintf(stderr, "return r3=%u error=%d resume=%08x\n",
+            (unsigned)env->gpr[3], guest_errno, (unsigned)env->nip);
+}
+
+void cpu_loop(CPUState *env)
+{
+    int trap;
+    for (;;) {
+        trap = cpu_exec(env);
+        switch (trap) {
+        case POWERPC_EXCP_SYSCALL_USER: darwin_syscall(env); break;
+        case EXCP_INTERRUPT: break;
+        case EXCP_DEBUG:
+            if (exit_bridge && env->nip == exit_bridge) {
+                fprintf(stderr, "probe-main: original PPC reached _exit bridge, status=%u\n",
+                        (unsigned)env->gpr[3]);
+                exit(env->gpr[3] & 255);
+            }
+            qerror("unexpected debug event at %08x", (unsigned)env->nip);
+            break;
+        default:
+            qerror("unsupported PPC exception %x pc=%08x", trap,
+                   (unsigned)env->nip);
+        }
+    }
+}
+
+int main(int argc, char **argv)
+{
+    struct target_pt_regs regs;
+    struct sigaction sa;
+    CPUState *env;
+    int i;
+    uint32_t probe_entry = 0;
+    int filearg = 1;
+    if (argc == 5 && !strcmp(argv[1], "--probe-main")) {
+        remaklar_probe_slide = 0x10000000;
+        probe_entry = strtoul(argv[2], NULL, 16) + remaklar_probe_slide;
+        exit_bridge = strtoul(argv[3], NULL, 16) + remaklar_probe_slide;
+        filearg = 4;
+    } else if (argc != 2) {
+        fprintf(stderr, "ReMaklar 0.01 bootstrap (Linux i386)\nusage: %s static-ppc.macho\n"
+                "or: %s --probe-main entry-hex exit-stub-hex original.macho\n", argv[0], argv[0]);
+        return 125;
+    }
+    cpu_set_log_filename("remaklar-tcg.log");
+    if (getenv("REMAKLAR_TRACE"))
+        cpu_set_log(cpu_str_to_log_mask("in_asm,out_asm,exec"));
+    cpu_exec_init_all(0);
+    env = cpu_init("750");
+    if (!env) qerror("cannot create PPC750 CPU");
+    global_env = cpu_single_env = env;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = host_signal;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = SA_SIGINFO;
+    sigaction(SIGSEGV, &sa, NULL);
+    sigaction(SIGBUS, &sa, NULL);
+    memset(&regs, 0, sizeof(regs));
+    mach_exec(argv[filearg], argv + filearg, environ, &regs);
+    env->nip = probe_entry ? probe_entry : regs.nip;
+    for (i = 0; i < 32; i++) env->gpr[i] = regs.gpr[i];
+    if (probe_entry && cpu_breakpoint_insert(env, exit_bridge, BP_GDB, NULL))
+        qerror("cannot install _exit bridge breakpoint");
+    fprintf(stderr, "loaded entry=%08x stack=%08x cpu=750 host=i386\n",
+            (unsigned)env->nip, (unsigned)env->gpr[1]);
+    cpu_loop(env);
+    return 125;
+}
