@@ -0,0 +1,37 @@
+/* Minimal fixed-width Mach-O wire definitions for the Linux bootstrap.
+ * ReMaklar, SPDX-License-Identifier: GPL-2.0-or-later.
+ * These are not substitutes for the Darwin SDK used by a native build.
+ */
+#ifndef REMAKLAR_MACH_LOADER_H
+#define REMAKLAR_MACH_LOADER_H
+#include <stdint.h>
+#define MH_MAGIC 0xfeedface
+#define MH_CIGAM 0xcefaedfe
+#define CPU_TYPE_I386 7
+#define CPU_TYPE_POWERPC 18
+#define MH_EXECUTE 2
+#define MH_FVMLIB 3
+#define MH_DYLIB 6
+#define MH_DYLINKER 7
+#define LC_SEGMENT 1
+#define LC_SYMTAB 2
+#define LC_THREAD 4
+#define LC_UNIXTHREAD 5
+#define LC_DYSYMTAB 0xb
+#define LC_LOAD_DYLIB 0xc
+#define LC_ID_DYLIB 0xd
+#define LC_LOAD_DYLINKER 0xe
+#define LC_ID_DYLINKER 0xf
+#define LC_SUB_LIBRARY 0x15
+#define LC_TWOLEVEL_HINTS 0x16
+#define LC_PREBIND_CKSUM 0x17
+#define LC_UUID 0x1b
+struct mach_header { uint32_t magic, cputype, cpusubtype, filetype, ncmds, sizeofcmds, flags; };
+struct load_command { uint32_t cmd, cmdsize; };
+struct segment_command {
+    uint32_t cmd, cmdsize; char segname[16];
+    uint32_t vmaddr, vmsize, fileoff, filesize, maxprot, initprot, nsects, flags;
+};
+struct dylinker_command { uint32_t cmd, cmdsize; union { uint32_t offset; } name; };
+struct symtab_command { uint32_t cmd, cmdsize, symoff, nsyms, stroff, strsize; };
+#endif
